      }
    },
    "owner": "avansoar1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/51d39abf-30e3-41c2-ba80-d09e5ec25f17"
    }
  }
