      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A9573F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dac0f710-2c28-4b99-a602-3105ea76c359"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
